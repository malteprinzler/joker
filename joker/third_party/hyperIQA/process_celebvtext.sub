# condor_submit_bid 25 process_celebvtext.sub
executable = hyperiqa_env.sh
arguments = process_celebvtext.py
request_cpus = 16
request_memory = 25000
request_gpus = 1
request_disk = 100G
WORLD_SIZE = 6
log = logfiles/process_celebvtext_$(ClusterId).$(Process).log
output = logfiles/process_celebvtext_(ClusterId).$(Process).out
error = logfiles/process_celebvtext_(ClusterId).$(Process).out
requirements = (TARGET.CUDACapability >= 7.0) && (TARGET.CUDAGlobalMemoryMb >=40000)
# requirements = (TARGET.CUDACapability >= 7.0) && (TARGET.CUDAGlobalMemoryMb >=40000) && && (TARGET.CUDADeviceName=="NVIDIA A100-SXM4-40GB") && (TARGET.CUDADeviceName=="NVIDIA H100 80GB HBM3")
# requirements = TARGET.CUDADeviceName=="Tesla V100-SXM2-32GB"
environment = "CONDOR_ClusterId=$(ClusterId) CONDOR_Process=$(Process) CONDOR_WorldSize=$(WORLD_SIZE)"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
remote_initialdir = $ENV(PWD)
queue $(WORLD_SIZE)
